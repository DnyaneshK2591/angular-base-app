.dropdown-container {
  position: relative;
  width: 200px;
}

.dropdown-toggle {
  border: 1px solid #ccc;
  padding: 8px;
  border-radius: 5px;
  background-color: white;
  cursor: pointer;
  display: flex;
  justify-content: space-between;
}

.dropdown-menu {
  position: absolute;
  width: 100%;
  background-color: white;
  border: 1px solid #ccc;
  margin-top: 5px;
  padding: 8px;
  z-index: 1000;
  max-height: 250px;
  overflow-y: auto;
}

.option {
  padding: 4px 0;
}

.dropdown-actions {
  margin-top: 8px;
  text-align: right;
}

button {
  padding: 5px 10px;
  border: none;
  background-color: #007bff;
  color: white;
  border-radius: 4px;
  cursor: pointer;
}